{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD046": { "style": "fenced" },
    "MD060": { "style": "fenced" }
  },
  "globs": ["docs/**/*.md", "*.md", "frontend/**/*.md"],
  // frontend/test-results is Playwright's own output: gitignored, regenerated
  // on every run, and never reviewed. Without it here, docs:check fails for
  // anyone who has run the browser tests locally.
  "ignores": ["CHANGELOG.md", "node_modules/**", "frontend/node_modules/**", "frontend/.next/**", "frontend/out/**", "frontend/test-results/**", "dist/**"]
}
